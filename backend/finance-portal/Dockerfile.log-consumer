# Build stage for Log Consumer
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY log-consumer-service/pom.xml ./pom.xml
COPY log-consumer-service/src ./src
RUN mvn clean package -DskipTests

# Runtime stage
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/target/log-consumer-service-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8082
ENTRYPOINT ["java","-jar","/app/app.jar"]
